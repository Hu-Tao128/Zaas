# Base de datos: Supabase/PostgreSQL (obligatoria).
# Usa el Session Pooler (puerto 5432) con ?sslmode=require.
#   DATABASE_URL=postgresql://postgres.<ref>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Flask
SECRET_KEY=cambia-esto-en-produccion

# Esquema: en producción se aplica con migrate_mr.py antes de arrancar.
AUTO_CREATE_SCHEMA=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# Firebase Auth — usa un archivo o pega el JSON de la service account.
# Descarga la key en: https://console.firebase.google.com → proyecto → Settings
#   → Service Accounts → Generate new private key
FIREBASE_KEY_PATH=keys/key.json
FIREBASE_CREDENTIALS_JSON=

# Orígenes permitidos (CORS y CSRF). En producción pon tu dominio real.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080

# Cookies de sesión entre subdominios sobre HTTPS.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=
