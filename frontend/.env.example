# Firebase Config — obtener desde Firebase Console
# Proyecto → Settings → General → Tus apps → Config
# En Docker/Coolify estas variables se pasan como Build Variables (Vite las
# incrusta en tiempo de build). Este archivo sirve para desarrollo local.
VITE_FIREBASE_API_KEY=tu-api-key
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu-sender-id
VITE_FIREBASE_APP_ID=tu-app-id
VITE_FIREBASE_MEASUREMENT_ID=tu-measurement-id

# La API se consume con rutas relativas (/api, /auth, /pagos/api, ...) que
# nginx redirige al backend. En Docker el destino se controla con BACKEND_URL
# en el contenedor del frontend; en desarrollo local usa el proxy de Vite.
