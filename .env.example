# Copia este archivo a .env en la raíz del proyecto y ajusta los valores.
# Docker Compose lee automáticamente .env.
# En Coolify define estas mismas variables en el recurso (Environment Variables)
# y las VITE_* como Build Variables.

# Puertos publicados en el host (solo para ejecución local con compose).
FRONTEND_PORT=8080
BACKEND_PORT=5000

# Clave de Flask para sesiones y CSRF. Genera una propia, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Base de datos.
# - Local/SQLite (por defecto): usa el volumen "zaas_db".
# - Coolify/Postgres: usa la URL interna del servicio de PostgreSQL. Se aceptan
#   tanto "postgres://" como "postgresql://"; el backend las adapta a psycopg2.
# - Supabase: copia la cadena "Connection pooling" (puerto 6543) o "Direct
#   connection" (puerto 5432) e incluye ?sslmode=require.
# Ejemplos:
#   DATABASE_URL=postgresql://zaas:zaas@db:5432/zaas
#   DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:////app/instance/zaas.db

# Supabase (opcional). Déjalos vacíos si no lo usas.
SUPABASE_URL=
SUPABASE_KEY=

# Firebase Admin: usa un archivo montado o el JSON completo por entorno.
# En Coolify es más práctico pegar el JSON de la service account aquí.
FIREBASE_KEY_PATH=keys/key.json
FIREBASE_CREDENTIALS_JSON=

# Dominios permitidos. En producción pon solo tu dominio real, separados por
# comas si hay varios. Si se dejan vacíos se usan valores de desarrollo.
CORS_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Cookies de sesión. Si frontend y backend comparten dominio principal, define
# SESSION_COOKIE_DOMAIN (p. ej. example.com) para permitir el intercambio entre
# subdominios. Con HTTPS conviene SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=

# URL del backend usada por nginx en el contenedor del frontend. En compose es
# el nombre del servicio; si despliegas por separado en Coolify usa la URL
# interna o pública del backend.
BACKEND_URL=http://backend:5000

# Configuración web de Firebase para el build del frontend (Vite). En Coolify
# defínelas como Build Variables. También puedes usar frontend/.env en local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Ajustes de Gunicorn. Con SQLite conviene mantener 1 worker.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
