# Copia este archivo a .env en la raíz del proyecto y ajusta los valores.
# Docker Compose lee automáticamente .env.

# Puertos publicados en el host.
FRONTEND_PORT=8080
BACKEND_PORT=5000

# Clave de Flask para sesiones y CSRF. Genera una propia, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Base de datos. Por defecto SQLite dentro del volumen "zaas_db".
# Para PostgreSQL, levanta un servicio adicional y usa algo como:
#   DATABASE_URL=postgresql+psycopg2://zaas:zaas@db:5432/zaas
DATABASE_URL=sqlite:////app/instance/zaas.db

# Supabase (opcional). Déjalos vacíos si no lo usas.
SUPABASE_URL=
SUPABASE_KEY=

# Ruta de la llave de Firebase Admin dentro del contenedor. El archivo real se
# monta desde ./backend/keys (por ejemplo ./backend/keys/key.json).
FIREBASE_KEY_PATH=keys/key.json

# Ajustes de Gunicorn. Con SQLite conviene mantener 1 worker.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
