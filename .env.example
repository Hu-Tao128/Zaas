# Copia este archivo a .env en la raíz del proyecto y ajusta los valores.
# Docker Compose lee automáticamente .env.
# En Coolify define estas mismas variables en el recurso (Environment Variables)
# y las VITE_* como Build Variables.

# Puertos publicados en el host (solo para ejecución local con compose).
FRONTEND_PORT=8080
BACKEND_PORT=5000

# Clave de Flask para sesiones y CSRF. Genera una propia, por ejemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# Base de datos: Supabase/PostgreSQL (obligatoria). Usa el Session Pooler
# (puerto 5432) e incluye ?sslmode=require. Puedes copiar la cadena desde
# Supabase → Project Settings → Database → Connection string.
# Ejemplo:
#   DATABASE_URL=postgresql://postgres.abcdefgh:TU_CLAVE@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# El esquema se gestiona con migrate_mr.py en el entrypoint del backend.
AUTO_CREATE_SCHEMA=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30

# Firebase Admin.
# - En Coolify: File Mount con destino /app/keys/key.json (recomendado).
# - Alternativa: pega el JSON completo de la service account en
#   FIREBASE_CREDENTIALS_JSON.
# - En local con docker-compose.override.yml: /app/keys/key.json.
FIREBASE_KEY_PATH=/app/keys/key.json
FIREBASE_CREDENTIALS_JSON=

# Dominios permitidos. En producción pon solo tu dominio real, separados por
# comas si hay varios. Si se dejan vacíos se usan valores de desarrollo.
CORS_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Cookies de sesión. Si frontend y backend comparten dominio principal, define
# SESSION_COOKIE_DOMAIN (p. ej. example.com) para permitir el intercambio entre
# subdominios. Con HTTPS conviene SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=
SESSION_COOKIE_SAMESITE=

# URL del backend usada por nginx en el contenedor del frontend. En compose es
# el nombre del servicio; si despliegas por separado en Coolify usa la URL
# interna o pública del backend.
BACKEND_URL=http://backend:5000

# Configuración web de Firebase para el build del frontend (Vite). En Coolify
# defínelas como Build Variables. También puedes usar frontend/.env en local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Ajustes de Gunicorn. Con Postgres puedes subir workers si el pool lo permite.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
