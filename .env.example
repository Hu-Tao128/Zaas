# Supabase — obtén estas credenciales en: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=eyJ... (service_role key completa, sin comillas)

# Firebase Auth — descarga la key en: https://console.firebase.google.com → proyecto → Settings → Service Accounts → Generate new private key
FIREBASE_KEY_PATH=keys/key.json

# Flask
SECRET_KEY=cambia-esto-en-produccion
